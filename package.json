{
  "name": "wsl-distro-manager",
  "displayName": "WSL Distro Manager",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "edtroleis",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/edtroleis/vscode-wsl-distro-manager.git"
  },
  "bugs": {
    "url": "https://github.com/edtroleis/vscode-wsl-distro-manager/issues"
  },
  "homepage": "https://github.com/edtroleis/vscode-wsl-distro-manager#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "wsl",
    "wsl2",
    "windows subsystem for linux",
    "distro",
    "linux",
    "wslconfig",
    "wsl.conf"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wslManager",
          "title": "WSL Distro Manager",
          "icon": "resources/wsl.svg"
        }
      ]
    },
    "views": {
      "wslManager": [
        {
          "id": "wslManager.distros",
          "name": "WSL Distro Manager",
          "icon": "resources/wsl.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wslManager.distros",
        "contents": "%welcome%"
      }
    ],
    "languages": [
      {
        "id": "ini",
        "filenames": [
          "wsl.conf",
          ".wslconfig"
        ]
      }
    ],
    "commands": [
      {
        "command": "wslManager.refresh",
        "title": "%command.refresh%",
        "category": "WSL Distro Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "wslManager.shutdown",
        "title": "%command.shutdown%",
        "category": "WSL Distro Manager",
        "icon": "$(debug-stop)"
      },
      {
        "command": "wslManager.repairInterop",
        "title": "%command.repairInterop%",
        "category": "WSL Distro Manager"
      },
      {
        "command": "wslManager.editWslConfig",
        "title": "%command.editWslConfig%",
        "category": "WSL Distro Manager",
        "icon": "$(settings-gear)"
      },
      {
        "command": "wslManager.install",
        "title": "%command.install%",
        "category": "WSL Distro Manager",
        "icon": "$(add)"
      },
      {
        "command": "wslManager.import",
        "title": "%command.import%",
        "category": "WSL Distro Manager",
        "icon": "$(cloud-download)"
      },
      {
        "command": "wslManager.openWindow",
        "title": "%command.openWindow%",
        "category": "WSL Distro Manager",
        "icon": "$(empty-window)"
      },
      {
        "command": "wslManager.openTerminal",
        "title": "%command.openTerminal%",
        "category": "WSL Distro Manager",
        "icon": "$(terminal)"
      },
      {
        "command": "wslManager.start",
        "title": "%command.start%",
        "category": "WSL Distro Manager",
        "icon": "$(play)"
      },
      {
        "command": "wslManager.terminate",
        "title": "%command.terminate%",
        "category": "WSL Distro Manager",
        "icon": "$(stop-circle)"
      },
      {
        "command": "wslManager.restart",
        "title": "%command.restart%",
        "category": "WSL Distro Manager",
        "icon": "$(debug-restart)"
      },
      {
        "command": "wslManager.setDefault",
        "title": "%command.setDefault%",
        "category": "WSL Distro Manager",
        "icon": "$(star-full)"
      },
      {
        "command": "wslManager.editWslConf",
        "title": "%command.editWslConf%",
        "category": "WSL Distro Manager",
        "icon": "$(settings)"
      },
      {
        "command": "wslManager.export",
        "title": "%command.export%",
        "category": "WSL Distro Manager",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "wslManager.compact",
        "title": "%command.compact%",
        "category": "WSL Distro Manager",
        "icon": "$(fold)"
      },
      {
        "command": "wslManager.move",
        "title": "%command.move%",
        "category": "WSL Distro Manager",
        "icon": "$(folder-opened)"
      },
      {
        "command": "wslManager.setVersion",
        "title": "%command.setVersion%",
        "category": "WSL Distro Manager"
      },
      {
        "command": "wslManager.unregister",
        "title": "%command.unregister%",
        "category": "WSL Distro Manager",
        "icon": "$(trash)"
      },
      {
        "command": "wslManager.copyName",
        "title": "%command.copyName%",
        "category": "WSL Distro Manager"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wslManager.install",
          "when": "view == wslManager.distros",
          "group": "1_manage@0"
        },
        {
          "command": "wslManager.refresh",
          "when": "view == wslManager.distros",
          "group": "navigation@1"
        },
        {
          "command": "wslManager.editWslConfig",
          "when": "view == wslManager.distros",
          "group": "navigation@2"
        },
        {
          "command": "wslManager.shutdown",
          "when": "view == wslManager.distros",
          "group": "navigation@3"
        },
        {
          "command": "wslManager.import",
          "when": "view == wslManager.distros",
          "group": "1_manage@1"
        },
        {
          "command": "wslManager.repairInterop",
          "when": "view == wslManager.distros",
          "group": "2_interop@1"
        }
      ],
      "view/item/context": [
        {
          "command": "wslManager.openWindow",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "inline@1"
        },
        {
          "command": "wslManager.openTerminal",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "inline@2"
        },
        {
          "command": "wslManager.start",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.stopped/",
          "group": "inline@3"
        },
        {
          "command": "wslManager.terminate",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.running/",
          "group": "inline@3"
        },
        {
          "command": "wslManager.openWindow",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "1_open@1"
        },
        {
          "command": "wslManager.openTerminal",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "1_open@2"
        },
        {
          "command": "wslManager.start",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.stopped/",
          "group": "2_lifecycle@1"
        },
        {
          "command": "wslManager.terminate",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.running/",
          "group": "2_lifecycle@1"
        },
        {
          "command": "wslManager.restart",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.running/",
          "group": "2_lifecycle@2"
        },
        {
          "command": "wslManager.setDefault",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.(running|stopped)$/",
          "group": "3_config@1"
        },
        {
          "command": "wslManager.editWslConf",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.(running|stopped)$/",
          "group": "3_config@2"
        },
        {
          "command": "wslManager.setVersion",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.(running|stopped)$/",
          "group": "3_config@3"
        },
        {
          "command": "wslManager.export",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "4_backup@1"
        },
        {
          "command": "wslManager.compact",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.(running|stopped)$/",
          "group": "4_backup@2"
        },
        {
          "command": "wslManager.move",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro\\.(running|stopped)$/",
          "group": "4_backup@3"
        },
        {
          "command": "wslManager.copyName",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "8_copy@1"
        },
        {
          "command": "wslManager.unregister",
          "when": "view == wslManager.distros && viewItem =~ /^wslDistro/",
          "group": "9_danger@1"
        },
        {
          "command": "wslManager.compact",
          "when": "view == wslManager.distros && viewItem == wslVhdx",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "WSL Distro Manager",
      "properties": {
        "wslManager.wslExePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.wslExePath%"
        },
        "wslManager.autoRefreshSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "%config.autoRefreshSeconds%"
        },
        "wslManager.metricsIntervalSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "markdownDescription": "%config.metricsIntervalSeconds%"
        },
        "wslManager.defaultUser": {
          "type": "string",
          "default": "",
          "description": "%config.defaultUser%"
        },
        "wslManager.clickAction": {
          "type": "string",
          "enum": [
            "expand",
            "terminal",
            "window",
            "none"
          ],
          "enumDescriptions": [
            "%config.clickAction.expand%",
            "%config.clickAction.terminal%",
            "%config.clickAction.window%",
            "%config.clickAction.none%"
          ],
          "default": "expand",
          "description": "%config.clickAction%"
        },
        "wslManager.showManagedDistros": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showManagedDistros%"
        },
        "wslManager.confirmDestructiveActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.confirmDestructiveActions%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "npm run compile && node --require ./out/test/setup.js --test \"out/test/**/*.test.js\"",
    "smoke": "npm run compile && node --require ./out/test/setup.js out/test/smoke.js",
    "smoke:windows": "npm run compile && bash scripts/smoke-windows.sh",
    "l10n": "l10n-dev export --outDir ./l10n ./src"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
